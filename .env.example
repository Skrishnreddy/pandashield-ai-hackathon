# PandaShield AI - Hackathon Edition
# Copy to backend/.env for local development. Never commit real values.
# These settings belong ONLY to the hackathon project; never reuse the
# existing PandaShield product's project, database or secrets.

# Google Cloud / Firebase project created for the hackathon
GOOGLE_CLOUD_PROJECT=pandashield-hackathon-REPLACE_ME
FIREBASE_PROJECT_ID=pandashield-hackathon-REPLACE_ME

# Firebase Web app config (public identifiers from Firebase console > Project settings)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=pandashield-hackathon-REPLACE_ME.firebaseapp.com
FIREBASE_APP_ID=

# Gemini
# On Cloud Run: Vertex AI with the service account (no key needed)
GEMINI_USE_VERTEX=true
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=LOW
# Local alternative: set GEMINI_USE_VERTEX=false and a Gemini API key
GEMINI_API_KEY=

# Optional limits
SCANS_PER_HOUR=20
ASKS_PER_HOUR=60

# Local emulators (set automatically by `firebase emulators:exec`)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
