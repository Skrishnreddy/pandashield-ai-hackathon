rules_version = '2';

// PandaShield AI - Hackathon Edition
// Browsers may only READ their own data. All writes go through the Cloud Run
// API (Firebase Admin SDK), which validates input and runs the scanners.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /scans/{scanId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /findings/{findingId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /diagnostics/{docId} {
        allow read, write: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
