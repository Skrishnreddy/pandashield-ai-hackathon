{
  "name": "pandashield-hackathon-backend",
  "version": "1.0.0",
  "description": "PandaShield AI Hackathon Edition - API server",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:emulator": "firebase emulators:exec --config ../firebase/firebase.json --project demo-pandashield --only auth,firestore \"node --test test/emulator.integration.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "tar-stream": "^3.2.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "firebase": "^13.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
